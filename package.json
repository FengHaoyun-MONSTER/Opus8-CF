{
  "name": "opus8-cf",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "分散多账号边缘节点 + 统一控制面的 Cloudflare 代理分发平台",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build:edge": "pnpm --filter @opus8-cf/edge-node build",
    "build:control": "pnpm --filter @opus8-cf/control-plane build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:compliance": "pnpm --filter @opus8-cf/control-plane test:compliance"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^5.6.0",
    "wrangler": "4.115.0",
    "esbuild": "^0.25.12"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
